    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Graphic --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
